@startuml

title Diagramme de Cas d'Utilisation du SGBD

left to right direction


skinparam backgroundColor #F5F5F5

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #C00000
    FontColor #000000
}

skinparam usecase {
    BackgroundColor #FFFACD
    BorderColor #C00000
    FontColor #000000
    ArrowColor #C00000
}


skinparam rectangle {
    BackgroundColor #F8F8F8
    BorderColor #000000
}

skinparam shadowing true


actor "Utilisateur" as User #FFE599


rectangle "SGBD" {

  usecase "Lancer le programme" as UC1
  usecase "Charger les données" as UC2

  usecase "Rechercher / Consulter\nles informations" as UC3
  usecase "Effectuer des opérations\nsur les tables" as UC4

  usecase "Créer une table" as UC5
  usecase "Supprimer une table" as UC6
  usecase "Consulter la liste\ndes tables" as UC7

  usecase "Insérer des informations" as UC8
  usecase "Supprimer des informations" as UC9

  usecase "Quitter le programme" as UC10
  usecase "Sauvegarder les données" as UC11
}


User --> UC1
UC1 ..> UC2 : <<include>>

User --> UC3
UC3 ..> UC4 : <<include>>

User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9

User --> UC10
UC10 ..> UC11 : <<include>>

@enduml